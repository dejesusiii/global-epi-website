{
  "id": "018f4c21-0000-7000-8000-000000000001",
  "version": 3,
  "code": "CHNA-SCR",
  "title": "Community Health Needs Assessment — Screener",
  "subtitle": "Pilot instrument · no identifying information is collected",
  "locale": "en",
  "estimatedMinutes": 8,
  "sections": [
    {
      "id": "context",
      "title": "Interview context",
      "questions": [
        { "id": "participant_code", "type": "text", "label": "Participant code",
          "hint": "Assigned from the sampling frame. Never a name.",
          "required": true, "mask": "AAA-000", "placeholder": "BAY-014",
          "help": "Three letters, a hyphen, three digits." },
        { "id": "municipio", "type": "select_one", "label": "Municipio",
          "required": true,
          "options": ["Bayamón", "Toa Baja", "Cataño", "Guaynabo", "Toa Alta", "Other"] },
        { "id": "municipio_other", "type": "text", "label": "Which municipio?",
          "required": true, "showIf": { "q": "municipio", "eq": "Other" } },
        { "id": "setting", "type": "select_one", "label": "Interview setting", "required": true,
          "options": ["Household", "Community centre", "Clinic waiting area", "Street intercept"] },
        { "id": "geo", "type": "geopoint", "label": "Location",
          "hint": "Optional. Captured only if the device allows it." }
      ]
    },
    {
      "id": "household",
      "title": "Household composition",
      "questions": [
        { "id": "hh_size", "type": "integer", "label": "People living in the household",
          "required": true, "min": 1, "max": 25 },
        { "id": "hh_under18", "type": "integer", "label": "Of those, how many are under 18?",
          "required": true, "min": 0, "max": 25,
          "atMostField": { "field": "hh_size", "message": "Cannot exceed the household size." } },
        { "id": "hh_over65", "type": "integer", "label": "Of those, how many are 65 or older?",
          "required": true, "min": 0, "max": 25,
          "atMostField": { "field": "hh_size", "message": "Cannot exceed the household size." } }
      ]
    },
    {
      "id": "access",
      "title": "Health care access and quality",
      "note": "Healthy People 2030 domain",
      "questions": [
        { "id": "has_coverage", "type": "select_one", "label": "Does everyone in the household have health coverage?",
          "required": true, "options": ["Yes, everyone", "Some, not all", "No one", "Don't know"] },
        { "id": "uncovered_reason", "type": "select_multi", "label": "What are the reasons for not having coverage?",
          "required": true, "showIf": { "q": "has_coverage", "in": ["Some, not all", "No one"] },
          "options": ["Cost", "Eligibility", "Application process", "Lost employment", "Not aware of options", "Other"] },
        { "id": "usual_source", "type": "select_one", "label": "Is there a usual place the household goes for care?",
          "required": true, "options": ["Primary care clinic", "Emergency department", "Urgent care", "No usual place"] },
        { "id": "travel_minutes", "type": "integer", "label": "Minutes to reach that place",
          "required": true, "min": 0, "max": 300,
          "showIf": { "q": "usual_source", "notEq": "No usual place" } },
        { "id": "delayed_care", "type": "select_one", "label": "In the past 12 months, did anyone delay or skip needed care?",
          "required": true, "options": ["Yes", "No", "Don't know"] },
        { "id": "delay_reason", "type": "select_multi", "label": "Why was care delayed or skipped?",
          "required": true, "showIf": { "q": "delayed_care", "eq": "Yes" },
          "options": ["Cost", "No transportation", "Could not get an appointment", "Could not take time off work", "No childcare", "Language barrier", "Other"] }
      ]
    },
    {
      "id": "economic",
      "title": "Economic stability",
      "note": "Healthy People 2030 domain",
      "questions": [
        { "id": "food_worry", "type": "select_one",
          "label": "In the past 12 months, did food run out before there was money to buy more?",
          "required": true, "options": ["Often true", "Sometimes true", "Never true", "Declined to answer"] },
        { "id": "housing_stability", "type": "select_one",
          "label": "How confident are you about keeping stable housing over the next year?",
          "required": true, "options": ["Very confident", "Somewhat confident", "Not confident", "Declined to answer"] }
      ]
    },
    {
      "id": "neighborhood",
      "title": "Neighborhood and social context",
      "note": "Healthy People 2030 domains",
      "questions": [
        { "id": "safety_scale", "type": "scale", "label": "How safe does the neighborhood feel?",
          "required": true, "min": 1, "max": 5,
          "minLabel": "Not safe at all", "maxLabel": "Very safe" },
        { "id": "cohesion_scale", "type": "scale", "label": "Neighbours can be counted on for help",
          "required": true, "min": 1, "max": 5,
          "minLabel": "Strongly disagree", "maxLabel": "Strongly agree" },
        { "id": "priority_need", "type": "select_multi", "label": "Which needs matter most here?",
          "required": true, "maxSelections": 3,
          "hint": "Choose up to three.",
          "options": ["Access to care", "Mental health services", "Food access", "Housing", "Transportation", "Employment", "Elder services", "Youth programs", "Environmental hazards"] },
        { "id": "observations", "type": "textarea", "label": "Interviewer observations",
          "hint": "Context that the answers above do not capture.",
          "maxLength": 600 }
      ]
    },
    {
      "id": "attestation",
      "title": "Attestation",
      "questions": [
        { "id": "no_pii", "type": "checkbox", "required": true,
          "label": "I confirm this record contains no names, addresses, phone numbers, dates of birth, or other identifying information." },
        { "id": "consent_given", "type": "checkbox", "required": true,
          "label": "The participant gave verbal consent after hearing the study description." }
      ]
    }
  ]
}
